---
import '../styles/global.css';
import { categoryLabel, getActiveDeals, getCategories } from '../lib/deals';
import { DEFAULT_OG_IMAGE, OG_IMAGE_SIZE, SITE_NAME, categoryPath } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  path?: string;
  marqueeItems?: string[];
  /** Site-relative path to a 1200×630 PNG. */
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  /** Pin the page language (e.g. the Vietnamese /vn/ view) regardless of the visitor's toggle. */
  forceLang?: 'en' | 'vi';
}

const {
  title,
  description = 'Black Friday & Cyber Monday 2026 deals for AI tools, developer tools, SaaS, hosting, and more. Prices verified from official merchant pages.',
  path = '/',
  marqueeItems = [],
  ogImage: ogImagePath = DEFAULT_OG_IMAGE,
  ogImageAlt = 'BF Deals 2026 — Black Friday & Cyber Monday deals',
  noindex = false,
  forceLang,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://bf-deals.haleduykhang.workers.dev';
const canonical = `${site}${path}`;
const ogImage = `${site}${ogImagePath}`;
const footerCategories = getCategories(getActiveDeals());
const ticker =
  marqueeItems.length > 0
    ? marqueeItems
    : ['AI · Dev tools · SaaS', 'Black Friday 27 Nov', 'Cyber Monday 30 Nov'];
// Duplicate for seamless loop
const tickerLoop = [...ticker, ...ticker];
---

<!doctype html>
<html lang={forceLang ?? 'en'} data-lang={forceLang ?? 'en'} data-force-lang={forceLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={forceLang === 'vi' ? 'vi_VN' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/syne-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to deals</a>

    <div class="disclosure-bar">
      <div class="wrap">
        <p>
          <strong>Affiliate disclosure:</strong>
          {' '}Some links are affiliate links; we may earn a commission at no extra cost to you.
        </p>
        <p>
          Một số link là link affiliate, mình có thể nhận hoa hồng mà bạn không tốn thêm tiền.
        </p>
      </div>
    </div>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {tickerLoop.map((item) => <span class="marquee__item">{item}</span>)}
      </div>
    </div>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">bf</span>
          <span class="brand__name">Deals <span>2026</span></span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/#deals">Deals</a>
          <a href="/?sort=ending-soon#deals">
            <span class="i18n-en">Ending soon</span>
            <span class="i18n-vi">Sắp hết</span>
          </a>
          <a href="/vn/" lang="vi">VN</a>
          <a href="/about/">About</a>
          <div class="lang-toggle" role="group" aria-label="Language">
            <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
            <button type="button" data-set-lang="vi" aria-pressed="false">VI</button>
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="wrap footer-cats" aria-label="Browse by category">
        <p>Browse by category</p>
        <ul>
          {footerCategories.map((cat) => (
            <li><a href={categoryPath(cat)}>{categoryLabel(cat, 'en')} deals</a></li>
          ))}
        </ul>
      </nav>
      <div class="wrap footer-grid">
        <div>
          <p>
            <strong>Affiliate disclosure:</strong>
            {' '}Some links are affiliate links; we may earn a commission at no extra cost to you.
          </p>
          <p>
            Một số link là link affiliate, mình có thể nhận hoa hồng mà bạn không tốn thêm tiền.
          </p>
          <p>
            Prices are as shown on the merchant page on the verified date and may change.
            Giá lấy đúng như trang merchant vào ngày xác minh; có thể thay đổi.
          </p>
        </div>
        <div>
          <p>
            <a href="/about/">About &amp; disclosure</a>
            ·
            <a href="https://bf-deals.haleduykhang.workers.dev">bf-deals.haleduykhang.workers.dev</a>
          </p>
          <p>Black Friday Fri 27 Nov 2026 · Cyber Monday Mon 30 Nov 2026</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const root = document.documentElement;
        const forced = root.getAttribute('data-force-lang');
        const saved = localStorage.getItem('bf-lang');
        const lang = forced || (saved === 'vi' || saved === 'en' ? saved : 'en');
        root.setAttribute('data-lang', lang);
        document.querySelectorAll('[data-set-lang]').forEach(function (btn) {
          const value = btn.getAttribute('data-set-lang');
          btn.setAttribute('aria-pressed', value === lang ? 'true' : 'false');
          btn.addEventListener('click', function () {
            root.setAttribute('data-lang', value);
            localStorage.setItem('bf-lang', value);
            document.querySelectorAll('[data-set-lang]').forEach(function (b) {
              b.setAttribute(
                'aria-pressed',
                b.getAttribute('data-set-lang') === value ? 'true' : 'false'
              );
            });
          });
        });
      })();
    </script>
  </body>
</html>
