---
/**
 * Client bootstrap for likes: fetch counts, wire buttons, top-10, most-liked sort.
 * Progressive enhancement — site works if /api/likes is unavailable.
 */
---

<script>
  const STORAGE_KEY = 'bf-likes-v1';
  const API = '/api/likes';

  type Counts = Record<string, number>;

  function readLiked(): Set<string> {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const arr = raw ? (JSON.parse(raw) as string[]) : [];
      return new Set(Array.isArray(arr) ? arr : []);
    } catch {
      return new Set();
    }
  }

  function writeLiked(set: Set<string>) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
    } catch {
      /* ignore quota */
    }
  }

  function dealMeta(id: string): { merchant: string; title: string } | null {
    const row = document.querySelector<HTMLElement>(`.deal-row[data-deal-id="${CSS.escape(id)}"]`);
    if (!row) return null;
    return {
      merchant: row.querySelector('.deal-row__merchant')?.textContent?.trim() || id,
      title: row.querySelector('.deal-row__title')?.textContent?.trim() || '',
    };
  }

  function setButtonState(btn: HTMLButtonElement, count: number, liked: boolean) {
    const countEl = btn.querySelector('[data-like-count]');
    if (countEl) countEl.textContent = String(count);
    btn.setAttribute('aria-pressed', liked ? 'true' : 'false');
    btn.classList.toggle('is-liked', liked);
    btn.setAttribute('aria-label', liked ? 'Unlike this deal' : 'Like this deal');
  }

  function applyCounts(counts: Counts, liked: Set<string>) {
    document.querySelectorAll<HTMLElement>('[data-deal-id]').forEach((el) => {
      const id = el.getAttribute('data-deal-id') || '';
      if (!id) return;
      const n = counts[id] ?? 0;
      el.dataset.likes = String(n);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-like-btn]').forEach((btn) => {
      const id = btn.getAttribute('data-deal-id') || '';
      setButtonState(btn, counts[id] ?? 0, liked.has(id));
    });
  }

  function renderTopLiked(counts: Counts) {
    const section = document.querySelector<HTMLElement>('[data-top-liked]');
    const list = document.querySelector<HTMLOListElement>('[data-top-liked-list]');
    if (!section || !list) return;

    const ranked = Object.entries(counts)
      .filter(([, n]) => n > 0)
      .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
      .slice(0, 10);

    if (ranked.length === 0) {
      section.hidden = true;
      list.innerHTML = '';
      return;
    }

    list.innerHTML = ranked
      .map(([id, n], i) => {
        const meta = dealMeta(id);
        const label = meta ? meta.merchant : id;
        const title = meta?.title ? ` — ${meta.title}` : '';
        return `<li class="top-liked__item">
          <span class="top-liked__rank">#${i + 1}</span>
          <a class="top-liked__link" href="#deal-${CSS.escape(id)}" data-scroll-deal="${id}">
            <strong>${escapeHtml(label)}</strong>
            <span class="top-liked__title">${escapeHtml(title)}</span>
          </a>
          <span class="top-liked__count">${n} ♥</span>
        </li>`;
      })
      .join('');

    section.hidden = false;

    list.querySelectorAll<HTMLAnchorElement>('[data-scroll-deal]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const id = a.getAttribute('data-scroll-deal') || '';
        const row = document.querySelector<HTMLElement>(`.deal-row[data-deal-id="${CSS.escape(id)}"]`);
        if (row) {
          row.hidden = false;
          row.scrollIntoView({ behavior: 'smooth', block: 'center' });
          row.classList.add('deal-row--flash');
          window.setTimeout(() => row.classList.remove('deal-row--flash'), 1200);
        }
      });
    });
  }

  function escapeHtml(s: string): string {
    return s
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  async function fetchCounts(): Promise<Counts> {
    const res = await fetch(API, { headers: { accept: 'application/json' } });
    if (!res.ok) throw new Error(`likes ${res.status}`);
    const data = (await res.json()) as Counts;
    return data && typeof data === 'object' ? data : {};
  }

  async function mutateLike(dealId: string, liked: boolean): Promise<{ count: number; liked: boolean }> {
    const res = await fetch(`${API}/${encodeURIComponent(dealId)}`, {
      method: liked ? 'DELETE' : 'POST',
      headers: { accept: 'application/json' },
    });
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      throw Object.assign(new Error('like_failed'), { status: res.status, body });
    }
    return (await res.json()) as { count: number; liked: boolean };
  }

  function initLikeButtons(counts: Counts, liked: Set<string>) {
    document.querySelectorAll<HTMLButtonElement>('[data-like-btn]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-deal-id') || '';
        if (!id || btn.dataset.busy === '1') return;

        const wasLiked = liked.has(id);
        const prevCount = Number(btn.querySelector('[data-like-count]')?.textContent || 0);
        const nextLiked = !wasLiked;
        const optimistic = Math.max(0, prevCount + (nextLiked ? 1 : -1));

        // Optimistic UI
        if (nextLiked) liked.add(id);
        else liked.delete(id);
        writeLiked(liked);
        setButtonState(btn, optimistic, nextLiked);
        document.querySelectorAll<HTMLElement>(`[data-deal-id="${CSS.escape(id)}"]`).forEach((el) => {
          el.dataset.likes = String(optimistic);
        });
        document.querySelectorAll<HTMLButtonElement>(`[data-like-btn][data-deal-id="${CSS.escape(id)}"]`).forEach((b) => {
          if (b !== btn) setButtonState(b, optimistic, nextLiked);
        });
        renderTopLiked(collectCountsFromDom());

        btn.dataset.busy = '1';
        try {
          const result = await mutateLike(id, wasLiked);
          setButtonState(btn, result.count, result.liked);
          document.querySelectorAll<HTMLElement>(`[data-deal-id="${CSS.escape(id)}"]`).forEach((el) => {
            el.dataset.likes = String(result.count);
          });
          document.querySelectorAll<HTMLButtonElement>(`[data-like-btn][data-deal-id="${CSS.escape(id)}"]`).forEach((b) => {
            setButtonState(b, result.count, result.liked);
          });
          if (result.liked) liked.add(id);
          else liked.delete(id);
          writeLiked(liked);
          renderTopLiked(collectCountsFromDom());
          // Re-apply sort if most-liked is active
          document.dispatchEvent(new CustomEvent('bf:likes-updated'));
        } catch {
          // Roll back optimistic UI; keep localStorage liked as user intent for display
          setButtonState(btn, prevCount, wasLiked);
          if (wasLiked) liked.add(id);
          else liked.delete(id);
          writeLiked(liked);
          document.querySelectorAll<HTMLElement>(`[data-deal-id="${CSS.escape(id)}"]`).forEach((el) => {
            el.dataset.likes = String(prevCount);
          });
          renderTopLiked(collectCountsFromDom());
        } finally {
          delete btn.dataset.busy;
        }
      });
    });
  }

  function collectCountsFromDom(): Counts {
    const out: Counts = {};
    document.querySelectorAll<HTMLElement>('.deal-row[data-deal-id]').forEach((el) => {
      const id = el.getAttribute('data-deal-id') || '';
      out[id] = Number(el.dataset.likes || 0);
    });
    return out;
  }

  async function boot() {
    const liked = readLiked();
    let counts: Counts = {};
    try {
      counts = await fetchCounts();
    } catch {
      counts = {};
    }
    applyCounts(counts, liked);
    renderTopLiked(counts);
    initLikeButtons(counts, liked);
    document.dispatchEvent(new CustomEvent('bf:likes-ready'));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => void boot());
  } else {
    void boot();
  }
</script>
