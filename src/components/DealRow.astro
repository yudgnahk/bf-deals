---
import CouponButton from './CouponButton.astro';
import LikeButton from './LikeButton.astro';
import MerchantIcon from './MerchantIcon.astro';
import ShareButton from './ShareButton.astro';
import {
  buildDealLink,
  categoryRank,
  daysUntilEnd,
  extractPromoCodes,
  formatDiscountBadge,
  parseDiscountPercent,
  parsePriceParts,
  type Deal,
} from '../lib/deals';
import { isNewDeal, newUntil } from '../lib/freshness';

interface Props {
  deal: Deal;
}

const { deal } = Astro.props;
const link = buildDealLink(deal);
const codes = extractPromoCodes(deal);
const pct = parseDiscountPercent(deal.discount_text);
const badge = formatDiscountBadge(deal.discount_text);
const prices = parsePriceParts(deal.price);
const days = daysUntilEnd(deal.end_date);
const showNew = isNewDeal(deal.added_at);
const newUntilIso = newUntil(deal.added_at);

let endsLabel: string | null = null;
if (days !== null) {
  if (days < 0) endsLabel = null;
  else if (days === 0) endsLabel = 'ends today';
  else if (days === 1) endsLabel = 'ends in 1 day';
  else endsLabel = `ends in ${days} days`;
} else if (deal.end_date) {
  endsLabel = `ends ${deal.end_date}`;
} else {
  endsLabel = 'no end date listed';
}

const endsUnknown = !deal.end_date && days === null;

const searchBlob = [
  deal.merchant,
  deal.title,
  deal.discount_text,
  deal.price,
  deal.category,
  ...codes,
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();

const rel = link.isAffiliate ? 'sponsored nofollow noopener' : link.rel;
---

<article
  class="deal-row"
  id={`deal-${deal.id}`}
  data-deal-id={deal.id}
  data-region={deal.region}
  data-category={deal.category}
  data-cat-rank={categoryRank(deal.category)}
  data-end-date={deal.end_date ?? ''}
  data-discount={pct ?? ''}
  data-added-at={deal.added_at ?? ''}
  data-has-code={codes.length > 0 ? '1' : '0'}
  data-likes="0"
  data-search={searchBlob}
>
  <a
    class="deal-row__hit"
    href={link.href}
    rel={rel}
    target="_blank"
    aria-label={`View ${deal.merchant} deal`}
  ></a>

  <div class="deal-row__main">
    <div class="deal-row__title-line">
      <MerchantIcon deal={deal} />
      <span class="deal-row__merchant">{deal.merchant}</span>
      {
        showNew && (
          <span class="new-tag" data-new-until={newUntilIso}>
            <span class="i18n-en">New</span>
            <span class="i18n-vi">Mới</span>
          </span>
        )
      }
      {
        deal.aff_status === 'hook' && (
          <span class="hook-tag">
            <span class="i18n-en">Hook</span>
            <span class="i18n-vi">Hook</span>
          </span>
        )
      }
    </div>
    <div class="deal-row__title">{deal.title}</div>
  </div>

  <div class="deal-row__aside deal-row__meta">
    {badge && <span class="pct-badge">{badge}</span>}
    {
      !badge && deal.discount_text && (
        <span class="deal-row__discount-text">{deal.discount_text}</span>
      )
    }
    {
      prices.original && prices.current ? (
        <span class="price-pair">
          <span class="price-pair__was">{prices.original}</span>
          <span class="price-pair__now">{prices.current}</span>
        </span>
      ) : prices.raw ? (
        <span class="price-pair__now">{prices.raw}</span>
      ) : null
    }
    {
      codes.length > 0 &&
        codes.slice(0, 1).map((code) => (
          <CouponButton deal={deal} code={code} />
        ))
    }
  {
    endsLabel && (
      <span class:list={['ends-meta', endsUnknown && 'ends-meta--unknown']}>
        {endsLabel}
      </span>
    )
  }
  </div>

  <div class="deal-row__actions">
    <LikeButton dealId={deal.id} compact />
    <ShareButton deal={deal} />
    <span class="deal-row__cta" aria-hidden="true">
      <span class="deal-row__cta-label">View</span>
      →
    </span>
  </div>
</article>
