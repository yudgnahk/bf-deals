---
import schedule from '../data/vn-schedule.json';
import { getActiveDeals, getVnDeals } from '../lib/deals';
import { dealPath } from '../lib/share.ts';
import { buildVnSchedule, type VnScheduleEntry } from '../lib/vn-schedule.ts';

const WINDOW_FROM = '2026-11-25';
const WINDOW_TO = '2026-11-30';

const merchants = Object.fromEntries(
  [...getActiveDeals(), ...getVnDeals()].map((d) => [d.id, d.merchant])
);
const days = buildVnSchedule(schedule as VnScheduleEntry[], merchants, WINDOW_FROM, WINDOW_TO);
---

<section class="vn-schedule wrap" aria-labelledby="vn-schedule-h">
  <h2 id="vn-schedule-h">Lịch săn sale 25–30/11</h2>
  <p class="vn-schedule__lede">
    Khung giờ và ngày chạy lấy từ trang chính thức của từng merchant. Ngày đã qua tự thu gọn.
  </p>
  <ol class="vn-schedule__days">
    {
      days.map((day) => (
        <li class="vn-day" data-date={day.date}>
          <h3>
            {day.label}
            {day.date === '2026-11-27' && <span class="vn-day__tag">Black Friday</span>}
            {day.date === '2026-11-30' && <span class="vn-day__tag">Cyber Monday</span>}
            <span class="vn-day__today" hidden>Hôm nay</span>
          </h3>
          {day.items.length === 0 ? (
            <p class="vn-day__empty">Chưa có lịch.</p>
          ) : (
            <ul>
              {day.items.map((item) => (
                <li>
                  <a href={dealPath(item.deal_id)}>{item.merchant}</a>
                  {item.starts && <span class="vn-flag">bắt đầu</span>}
                  {item.lastDay && <span class="vn-flag vn-flag--last">ngày cuối</span>}
                  {item.slots && <span class="vn-slots">{item.slots}</span>}
                  <span class="vn-what">{item.what}</span>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</section>

<script>
  // Marks today (Asia/Saigon) and collapses past days without a rebuild.
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' }).format(new Date());
  document.querySelectorAll<HTMLElement>('.vn-day[data-date]').forEach((el) => {
    const date = el.dataset.date || '';
    if (date < today) el.classList.add('is-past');
    if (date === today) {
      el.classList.add('is-today');
      el.querySelector<HTMLElement>('.vn-day__today')?.removeAttribute('hidden');
    }
  });
</script>
