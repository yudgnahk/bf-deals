---
import { formatDiscountBadge, type Deal } from '../lib/deals';
import { endingWithin } from '../lib/freshness';

interface Props {
  deals: Deal[];
  days?: number;
  limit?: number;
}

const { deals, days = 3, limit = 8 } = Astro.props;
// One tile per merchant so a retailer with many doorbusters doesn't fill the strip.
const soon = endingWithin(deals, days)
  .filter((deal, i, list) => list.findIndex((d) => d.merchant === deal.merchant) === i)
  .slice(0, limit);
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const shortDate = (iso: string) => {
  const [, m, d] = iso.split('-');
  return `${Number(d)} ${months[Number(m) - 1]}`;
};
const shortDateVi = (iso: string) => {
  const [, m, d] = iso.split('-');
  return `${Number(d)}/${Number(m)}`;
};
---

{
  soon.length > 0 && (
    <section class="ending-soon wrap" aria-labelledby="ending-soon-title">
      <div class="ending-soon__head">
        <h2 id="ending-soon-title">
          <span class="i18n-en">Ending soon</span>
          <span class="i18n-vi">Sắp hết hạn</span>
        </h2>
        <a href="?sort=ending-soon#deals" class="ending-soon__all">
          <span class="i18n-en">Sort all by end date →</span>
          <span class="i18n-vi">Xếp tất cả theo hạn →</span>
        </a>
      </div>
      <ol class="ending-soon__list">
        {soon.map((deal) => (
          <li data-end-date={deal.end_date}>
            <a href={`#deal-${deal.id}`}>
              <strong>{deal.merchant}</strong>
              {formatDiscountBadge(deal.discount_text) && (
                <span class="pct-badge">{formatDiscountBadge(deal.discount_text)}</span>
              )}
              <span class="ends-meta">
                <span class="i18n-en">ends {shortDate(deal.end_date as string)}</span>
                <span class="i18n-vi">hết hạn {shortDateVi(deal.end_date as string)}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}

<script>
  function hideEnded() {
    const now = new Date();
    document.querySelectorAll<HTMLElement>('.ending-soon__list li[data-end-date]').forEach((li) => {
      const [y, m, d] = (li.dataset.endDate || '').split('-').map(Number);
      if (y && m && d && now > new Date(y, m - 1, d, 23, 59, 59, 999)) li.remove();
    });
  }
  hideEnded();
</script>
