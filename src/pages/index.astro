---
import { salePhase } from '../lib/sale-phase';
import BaseLayout from '../layouts/BaseLayout.astro';
import DealBoard from '../components/DealBoard.astro';
import EndingSoon from '../components/EndingSoon.astro';
import FeaturedDeal from '../components/FeaturedDeal.astro';
import JsonLd from '../components/JsonLd.astro';
import LikesInit from '../components/LikesInit.astro';
import TopLiked from '../components/TopLiked.astro';
import {
  formatDiscountBadge,
  getActiveDeals,
  getCategories,
  getCategoryCounts,
  getFeaturedDeals,
  getLastVerifiedDate,
  parseDiscountPercent,
  sortEndingSoon,
} from '../lib/deals';
import { buildItemListJsonLd, buildWebsiteJsonLd } from '../lib/seo';

const activeDeals = sortEndingSoon(getActiveDeals());
const categories = getCategories(activeDeals);
const counts = getCategoryCounts(activeDeals);
const lastVerified = getLastVerifiedDate(activeDeals);
const featured = getFeaturedDeals(activeDeals, 5);
const [heroDeal, ...sideDeals] = featured;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const jsonLd = [
  buildWebsiteJsonLd(site),
  buildItemListJsonLd(activeDeals, {
    name: 'Black Friday & Cyber Monday 2026 deals',
    pageUrl: `${site}/`,
  }),
];

const checkedLabel = lastVerified
  ? lastVerified.replace(/^(\d{4})-(\d{2})-(\d{2})$/, (_, y, m, d) => {
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      return `${Number(d)} ${months[Number(m) - 1]} ${y}`;
    })
  : '—';

const marqueeItems = activeDeals
  .map((d) => {
    const badge = formatDiscountBadge(d.discount_text);
    const pct = parseDiscountPercent(d.discount_text);
    if (!badge && !pct) return null;
    const label = badge || `${pct}%`;
    return `${d.merchant} · ${label}`;
  })
  .filter((x): x is string => Boolean(x))
  .slice(0, 14);
const buildPhase = salePhase(Date.now());
---

<BaseLayout
  title="BF Deals 2026 — Black Friday & Cyber Monday AI, SaaS & Dev Tools"
  description="International Black Friday and Cyber Monday 2026 deals for AI tools, developer tools, SaaS, hosting, and more. Prices verified from official merchant pages."
  path="/"
  marqueeItems={marqueeItems}
  ogImage="/og/site.png"
>
  <JsonLd slot="head" data={jsonLd} />
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="hero__kicker">
          AI · Dev tools · SaaS — checked {checkedLabel}
        </p>
        <h1>
          <span>Black</span>
          <span>Friday</span>
        </h1>
        <p class="hero__lede">
          <span class="i18n-en">
            International deals, copied from official merchant pages. Prices and
            discount text as printed — no invented numbers.
          </span>
          <span class="i18n-vi">
            Deal quốc tế, copy từ trang merchant chính thức. Giá và chữ giảm giá
            đúng như in — không bịa số.
          </span>
        </p>
      </div>

      <aside class="clock" aria-live="polite">
        <p class="clock__label">
          <span class="i18n-en" data-phase-label="en">{buildPhase.label.en}</span>
          <span class="i18n-vi" data-phase-label="vi">{buildPhase.label.vi}</span>
        </p>
        <div class="clock__digits" data-departure-clock>
          <div>
            <b data-cd="d">—</b>
            <i>days</i>
          </div>
          <div>
            <b data-cd="h">—</b>
            <i>hours</i>
          </div>
          <div>
            <b data-cd="m">—</b>
            <i>min</i>
          </div>
          <div>
            <b data-cd="s">—</b>
            <i>sec</i>
          </div>
        </div>
        <p class="clock__sub">
          <span class="i18n-en" data-phase-sub="en">{buildPhase.sub.en}</span>
          <span class="i18n-vi" data-phase-sub="vi">{buildPhase.sub.vi}</span>
        </p>
      </aside>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="featured wrap" aria-label="Featured deals" id="deals">
        <p class="featured__label">
          <span class="i18n-en">Featured</span>
          <span class="i18n-vi">Nổi bật</span>
        </p>
        <div class="featured-bento">
          {heroDeal && <FeaturedDeal deal={heroDeal} rank={1} hero />}
          {sideDeals.map((deal, i) => (
            <FeaturedDeal deal={deal} rank={i + 2} />
          ))}
        </div>
      </section>
    )
  }

  <div class="wrap">
    <TopLiked />
  </div>

  <EndingSoon deals={activeDeals} />

  <DealBoard
    deals={activeDeals}
    categories={categories}
    counts={counts}
    lastVerified={lastVerified}
  />
  <LikesInit />

  <script>
    import { salePhase, splitDuration } from '../lib/sale-phase';

    function pad(n: number) {
      return String(n).padStart(2, '0');
    }

    function setText(selector: string, text: string) {
      document.querySelectorAll<HTMLElement>(selector).forEach((el) => {
        if (el.textContent !== text) el.textContent = text;
      });
    }

    function tickClock() {
      const root = document.querySelector<HTMLElement>('[data-departure-clock]');
      if (!root) return;
      const now = Date.now();
      const phase = salePhase(now);
      setText('[data-phase-label="en"]', phase.label.en);
      setText('[data-phase-label="vi"]', phase.label.vi);
      setText('[data-phase-sub="en"]', phase.sub.en);
      setText('[data-phase-sub="vi"]', phase.sub.vi);
      root.hidden = phase.target === null;
      const t = splitDuration(phase.target === null ? 0 : phase.target - now);
      const map: Record<string, string> = { d: String(t.d), h: pad(t.h), m: pad(t.m), s: pad(t.s) };
      root.querySelectorAll<HTMLElement>('[data-cd]').forEach((el) => {
        el.textContent = map[el.getAttribute('data-cd') || ''] ?? '—';
      });
    }

    tickClock();
    window.setInterval(tickClock, 1000);
  </script>
</BaseLayout>
