---
import BaseLayout from '../layouts/BaseLayout.astro';
import DealRow from '../components/DealRow.astro';
import FeaturedDeal from '../components/FeaturedDeal.astro';
import Filters from '../components/Filters.astro';
import LikesInit from '../components/LikesInit.astro';
import TopLiked from '../components/TopLiked.astro';
import {
  getActiveDeals,
  getCategories,
  getCategoryCounts,
  getFeaturedDeals,
  getLastVerifiedDate,
  matchesRegion,
  sortEndingSoon,
  DEFAULT_REGION_FILTER,
} from '../lib/deals';

const activeDeals = sortEndingSoon(getActiveDeals());
const categories = getCategories(activeDeals);
const counts = getCategoryCounts(activeDeals);
const lastVerified = getLastVerifiedDate(activeDeals);
const featured = getFeaturedDeals(activeDeals, 2);
const listDeals = activeDeals;

const initialVisible = activeDeals.filter((d) =>
  matchesRegion(d, DEFAULT_REGION_FILTER)
);
const initialCount = initialVisible.length;
---

<BaseLayout
  title="BF Deals 2026 — Black Friday & Cyber Monday AI, SaaS & Dev Tools"
  description="International Black Friday and Cyber Monday 2026 deals for AI tools, developer tools, SaaS, hosting, and more. Prices verified from official merchant pages."
  path="/"
>
  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow">Exclusive limited-time offers for builders</p>
      <h1>Black Friday <em>Sale</em></h1>
      <p class="hero__lede">
        <span class="i18n-en">
          AI tools, developer tools, and SaaS — international deals checked on
          official merchant pages. Prices and discount text are copied as shown.
        </span>
        <span class="i18n-vi">
          Công cụ AI, lập trình và SaaS — deal quốc tế đối chiếu từ trang merchant.
          Giá và chữ giảm giá copy đúng như hiển thị.
        </span>
      </p>
      <div class="countdown-bar" data-countdown>
        <span class="countdown-bar__short"><strong>BF soon</strong> · CM soon</span>
        <span class="countdown-bar__full"><strong>T−? days to Black Friday</strong> · Cyber Monday · Fri 27 Nov / Mon 30 Nov 2026</span>
      </div>
      <p class="hero__meta">
        Last checked {lastVerified || '—'}
        · Prices may change
      </p>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="featured wrap" aria-label="Featured deals">
        <p class="featured__label">
          <span class="i18n-en">Featured</span>
          <span class="i18n-vi">Nổi bật</span>
        </p>
        <div class="featured-grid">
          {featured.map((deal, i) => (
            <FeaturedDeal deal={deal} rank={i + 1} />
          ))}
        </div>
      </section>
    )
  }

  <div class="wrap">
    <TopLiked />
  </div>

  <div class="board wrap">
    <Filters categories={categories} counts={counts} total={activeDeals.length} />

    <div class="results-meta">
      <p>
        <span data-deal-count>{initialCount}</span> deals
      </p>
      <p>Last checked {lastVerified || '—'}</p>
    </div>

    <div class="deal-list" data-deal-list>
      {listDeals.map((deal) => <DealRow deal={deal} />)}
    </div>
    <p class="empty-state" data-empty hidden>
      <span class="i18n-en">No deals match these filters.</span>
      <span class="i18n-vi">Không có deal khớp bộ lọc này.</span>
    </p>
  </div>
  <LikesInit />
</BaseLayout>
